{
  "$schema": "https://biomejs.dev/schemas/2.5.2/schema.json",
  "assist": { "actions": { "source": { "organizeImports": "on" } } },
  "formatter": {
    "enabled": true,
    "formatWithErrors": false,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 80,
    "lineEnding": "lf",
    "attributePosition": "auto"
  },
  "javascript": {
    "formatter": {
      "arrowParentheses": "always",
      "bracketSameLine": false,
      "bracketSpacing": true,
      "jsxQuoteStyle": "double",
      "quoteProperties": "asNeeded",
      "quoteStyle": "double",
      "semicolons": "asNeeded",
      "trailingCommas": "es5"
    }
  },
  "css": {
    "parser": {
      "tailwindDirectives": true
    },
    "formatter": {
      "enabled": true
    }
  },
  "json": {
    "formatter": {
      "trailingCommas": "none"
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",
      "complexity": {
        "noBannedTypes": "off",
        "noForEach": "off",
        "useLiteralKeys": "off"
      },
      "correctness": {
        "noUnusedVariables": "warn",
        "useExhaustiveDependencies": "off",
        "useJsxKeyInIterable": "off",
        "noUnknownMediaFeatureName": "off",
        "useHookAtTopLevel": "off"
      },
      "style": {
        "noNonNullAssertion": "off",
        "useConsistentArrayType": {
          "level": "error",
          "options": {
            "syntax": "shorthand"
          }
        },
        "useImportType": "error",
        "useNodejsImportProtocol": "off",
        "noDefaultExport": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noArrayIndexKey": "off",
        "useAwait": "warn",
        "noDocumentCookie": "off",
        "noRedeclare": "off",
        "noAssignInExpressions": "off"
      },
      "a11y": {
        "useKeyWithClickEvents": "off",
        "useButtonType": "off",
        "noSvgWithoutTitle": "off",
        "useAltText": "off",
        "useAnchorContent": "off",
        "useHeadingContent": "off",
        "useMediaCaption": "off",
        "noAutofocus": "off",
        "noNoninteractiveTabindex": "off",
        "useAriaPropsForRole": "off",
        "useAriaPropsSupportedByRole": "off",
        "useFocusableInteractive": "off",
        "useIframeTitle": "off",
        "noStaticElementInteractions": "off",
        "useSemanticElements": "off",
        "noAmbiguousAnchorText": "off",
        "useValidAnchor": "off"
      },
      "security": {
        "noDangerouslySetInnerHtml": "off"
      },
      "performance": {
        "noImgElement": "off",
        "noBarrelFile": "off",
        "noReExportAll": "off"
      }
    },
    "includes": ["**", "!**/*.d.ts"]
  },
  "files": {
    "ignoreUnknown": false,
    "includes": [
      "**",
      "!**/node_modules",
      "!**/.next",
      "!**/out",
      "!**/build",
      "!**/target",
      "!**/inspirations",
      "!**/public",
      "!**/src/registry/__index__.tsx",
      "!**/next-env.d.ts",
      "!**/src/registry/__blocks__.json",
      "!**/src/registry/registry.autogenerated.json",
      "!**/src/registry/transformed",
      "!**/public/r",
      "!**/registry.json",
      "!**/packages",
      "!**/*.mjs",
      "!**/*.cjs",
      "!**/dx.html"
    ]
  }
}
