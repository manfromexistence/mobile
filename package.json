  "scripts": {
    "dev": "next dev --webpack",
    "build": "bun run registry:build && next build --webpack",
    "start": "next start",
    "preview": "bun run registry:build && next build && next start",
    "test": "vitest",
    "test:run": "vitest run",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "lint:eslint": "eslint . --cache --cache-location .eslintcache",
    "lint:eslint:fix": "eslint --fix . --cache --cache-location .eslintcache",
    "check-types": "tsc --noEmit --pretty",
    "format:check": "biome format",
    "format:write": "biome format --write",
    "format:prettier": "prettier --check \"**/*.{ts,tsx,md,mdx}\" --cache",
    "format:prettier:write": "prettier --write \"**/*.{ts,tsx,md,mdx}\" --cache",
    "registry:build": "bun run ./src/scripts/build-registry.mts && shadcn build",
    "registry:validate": "shadcn registry validate ./public/r/registry.json",
    "capture": "bun run ./src/scripts/capture.mts",
    "capture:sync": "bun run ./src/scripts/capture-sync.mts",
    "tauri:dev": "tauri dev",
    "tauri:build": "tauri build",
    "icons:dev": "bun run ./src/scripts/build-icons.ts --watch",
    "icons:build": "bun run ./src/scripts/build-icons.ts",
    "generate-libphonenumber-metadata": "libphonenumber-metadata-generator ./src/assets/libphonenumber.metadata.json --countries VN --extended",
    "upgrade:next": "npx @next/codemod@latest upgrade latest",
    "upgrade:tailwind": "npx @tailwindcss/upgrade@latest"
  },
