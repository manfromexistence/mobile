{
  "name": "dx",
  "private": true,
  "description": "chanhdai.com - Internal Dev Codename: dx",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:web": "turbo run dev",
    "build": "next build",
    "build:web": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "clean": "turbo run clean",
    "format:write": "biome format --write .",
    "format:check": "biome format .",
    "lint:fix": "biome lint --apply .",
    "ci": "bun run lint && bun run typecheck && bun run test"
  },
  "workspaces": ["apps/*", "packages/*"],
  "devDependencies": {
    "@biomejs/biome": "^1.9.4",
    "@changesets/cli": "^2.27.0",
    "next": "16.2.10",
    "react": "19.2.7",
    "react-dom": "19.2.7",
    "turbo": "^2.3.0",
    "typescript": "^5.7.0"
  },
  "engines": {
    "bun": ">=1.2.0",
    "node": ">=24.16.0"
  },
  "packageManager": "bun@1.2.0"
}
